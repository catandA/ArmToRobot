<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/buttons"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_camera"
            style="@style/middle_btn"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/start_camera"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_camera_alt_24" />

        <ImageButton
            android:id="@+id/bluetooth_btn"
            style="@style/middle_btn"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/bluetooth_state_disconnected"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bluetooth_transient_animation_red" />


        <ImageButton
            android:id="@+id/set_btn"
            style="@style/middle_btn"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/set"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_24dp" />

        <ImageButton
            android:id="@+id/test_btn"
            style="@style/middle_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/refresh"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/network_btn"
            style="@style/middle_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/network_not_connected"
            android:scaleType="fitCenter"
            android:src="@drawable/stat_notify_wifi_in_range" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/preview_display_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </FrameLayout>
</LinearLayout>
